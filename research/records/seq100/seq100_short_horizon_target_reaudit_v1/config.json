{
  "study_id": "seq100_short_horizon_target_reaudit_v1",
  "objective": "Reassess D1/D3 targets and upside-opportunity labels before expanding features or selecting a successor architecture.",
  "data": {
    "base_config": {
      "path": "daily_research/research_records/seq100/seq100_path_label_learnability_v1/config.json"
    },
    "short_label_manifest": {
      "path": "tmp/seq100_short_horizon_target_reaudit/attempt_001/labels/short_label_manifest.json"
    },
    "row_universe": "all point-in-time main-board candidates without future fill or label filtering",
    "feature_profile": "the same 296 continuous and 5 train-mapped categorical causal features as the base learnability study",
    "maximum_information_time": "signal-date close or earlier"
  },
  "labels": {
    "g_1": "next-open to D1 close endpoint return",
    "g_3": "next-open to D3 close endpoint return",
    "mfe_3": "maximum legal sellable D2-D3 close return",
    "pre_peak_mae_3": "adversity before the best legal D2-D3 close",
    "state_3": "through-2022 fixed-K3 D1-D3 path state ordered by endpoint"
  },
  "folds": {
    "fold_years": [
      2023,
      2024,
      2025
    ],
    "targets_by_horizon": {
      "1": [
        "g"
      ],
      "3": [
        "g",
        "mfe",
        "pre_peak_mae",
        "state"
      ]
    },
    "maximum_outcome_date": "2025-12-31",
    "train_window": "expanding from the first candidate date",
    "purge_rule": "signal_date_idx + dependency_days < evaluation_start_date_idx",
    "sample_weight": "each signal date has equal total weight within each target",
    "fold_role": "recent reused comparison folds, not a pristine holdout"
  },
  "model": {
    "library": "lightgbm",
    "boosting_type": "gbdt",
    "device_type": "cpu",
    "learning_rate": 0.03,
    "num_boost_round": 1500,
    "early_stopping_rounds": 100,
    "num_leaves": 63,
    "max_depth": 7,
    "min_data_in_leaf": 10000,
    "feature_fraction": 0.8,
    "bagging_fraction": 0.8,
    "bagging_freq": 1,
    "lambda_l1": 0.0,
    "lambda_l2": 10.0,
    "max_bin": 255,
    "huber_alpha": 0.9,
    "deterministic": true,
    "force_col_wise": true,
    "num_threads": 8,
    "histogram_pool_size_mb": 1024,
    "sequence_batch_size": 32768,
    "working_set_trim": {
      "enabled": true,
      "check_interval_batches": 4,
      "trigger_available_gb": 5.0
    },
    "seed": 7,
    "target_scaling": "none",
    "hyperparameter_search": false,
    "ranking_objective": false
  },
  "evaluation": {
    "regression": [
      "daily cross-sectional Spearman Rank IC",
      "daily score-decile monotonicity and spread",
      "daily top 1% and 5% target lift",
      "Newey-West HAC with lag H-1"
    ],
    "mfe_upper_tail": "Top-5% score enrichment of realized within-date MFE top quintile",
    "state_probability": "sequential temperature calibration using prior OOS folds only",
    "market_stock_separation": true,
    "pooled_only_conclusions": false
  },
  "decision": {
    "qualification_thresholds": {
      "minimum_worst_year_rank_ic": 0.01,
      "maximum_hac_p_value": 0.05,
      "minimum_hac_supported_years": 2,
      "minimum_top1_positive_years": 2,
      "minimum_monotone_years": 2,
      "minimum_decile_spearman": 0.5,
      "minimum_no_reversal_decile_spearman": -0.2,
      "maximum_state_endpoint_tertile_nmi": 0.8,
      "minimum_residual_rank_ic": 0.01
    }
  },
  "output": {
    "input_root": "tmp/seq100_short_horizon_target_reaudit/attempt_001",
    "root": "daily_research/output/path_policy/studies/seq100_short_horizon_target_reaudit_v1",
    "resume_unit": "one completed target-horizon-fold booster"
  }
}
