{
  "study_id": "seq100_quality_liquidity_t1_return_models",
  "purpose": "Train six bounded rolling LightGBM heads for strict T+1 open-to-open and open-to-D2-close returns.",
  "source": {
    "model_input_manifest": "daily_research/output/path_policy/studies/seq100_quality_liquidity_training_ready/model_inputs/manifest.json",
    "t1_target_manifest": "daily_research/output/path_policy/studies/seq100_quality_liquidity_t1_targets/manifest.json",
    "frozen_g1_root": "daily_research/output/path_policy/studies/seq100_quality_liquidity_model/direct_returns",
    "source_model_study_id": "seq100_quality_liquidity_model",
    "source_target_study_id": "seq100_quality_liquidity_t1_targets",
    "maximum_outcome_date": "2025-12-31",
    "forbidden_year": 2026,
    "candidate_selection_uses_future_fill": false
  },
  "period": {
    "burn_in_year": 2010,
    "research_years": [
      2011,
      2012,
      2013,
      2014,
      2015,
      2016,
      2017,
      2018,
      2019,
      2020,
      2021,
      2022,
      2023,
      2024,
      2025
    ],
    "rolling_prediction_years": [2023, 2024, 2025]
  },
  "feature_contract": {
    "variant": "compact_core",
    "feature_count": 557,
    "feature_set_selected": false
  },
  "targets": {
    "open_to_open_1": {
      "kind": "return",
      "horizon": 2,
      "entry": "next_trading_day_open",
      "exit": "second_next_trading_day_open",
      "formula": "adjusted_open[t+2] / adjusted_open[t+1] - 1",
      "source": "audited_t1_target_contract"
    },
    "open_to_close_2": {
      "kind": "return",
      "horizon": 2,
      "entry": "next_trading_day_open",
      "exit": "second_next_trading_day_close",
      "formula": "adjusted_close[t+2] / adjusted_open[t+1] - 1",
      "source": "derived_from_audited_pack"
    }
  },
  "label_contract": {
    "price_semantics": "back_adjusted_total_return",
    "outcome_dependency_trading_days": 2,
    "training_purge": "maximum signal index equals OOS start index minus 3",
    "future_fill_used_for_label_support": false,
    "decomposition": "(1 + open_to_open_1) * (1 + exit_open_to_close_2) - 1 = open_to_close_2",
    "normalization": {
      "group": "signal_trade_date_cross_section",
      "winsor_quantiles": [0.01, 0.99],
      "quantile_method": "nearest",
      "zscore_ddof": 0,
      "minimum_cross_section": 20
    }
  },
  "model": {
    "library": "lightgbm",
    "learning_rate": 0.03,
    "num_leaves": 63,
    "max_depth": 7,
    "min_data_in_leaf": 10000,
    "lambda_l2": 10.0,
    "max_bin": 255,
    "feature_fraction": 1.0,
    "bagging_fraction": 1.0,
    "bagging_freq": 0,
    "num_threads": 8,
    "seed": 7,
    "huber_alpha": 0.9,
    "fixed_mfe_rounds": 512,
    "adaptive_max_rounds": 1500,
    "adaptive_patience": 100,
    "histogram_pool_size_mb": 1024,
    "sequence_batch_size": 32768,
    "working_set_trim": {
      "enabled": true,
      "check_interval_batches": 4,
      "trigger_available_gb": 5.0
    }
  },
  "comparison": {
    "baseline_model": "frozen_g_1",
    "identical_target_support": true,
    "metrics": [
      "rank_ic",
      "top1_excess_mean",
      "top5_excess_mean",
      "top1_capture",
      "top5_capture",
      "decile_spearman",
      "zscore_mse"
    ]
  },
  "execution": {
    "training_performed": true,
    "task_count": 6,
    "one_booster_at_a_time": true,
    "date_equal_weighting": true,
    "save_daily_metrics": true,
    "execution_replay_performed": false,
    "feature_set_selected": false,
    "production_policy_selected": false,
    "html_report": false,
    "evaluation_semantics": "retrospective_rolling_oos"
  }
}
