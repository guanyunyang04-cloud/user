{
  "schema_version": 1,
  "contract_id": "seq100_pit_adjusted_global_tail_contract_20260711",
  "status": "approved_implementation",
  "approved_at": "2026-07-11",
  "research_scope": {
    "decision_time": "signal_day_after_close",
    "exchange_scope": "Shanghai and Shenzhen A-share main board",
    "excluded_boards": ["ChiNext", "STAR", "BSE"],
    "eligibility_semantics": "point_in_time",
    "signal_day_requirements": [
      "listed",
      "mainboard",
      "not_st",
      "not_delisted",
      "not_suspended"
    ],
    "future_status_must_not_filter_history": true
  },
  "entry": {
    "timing": "next_trading_day_open",
    "filled_when": "open is finite, security is not suspended, and tick-rounded open is below tick-rounded up_limit",
    "unfilled_action": "retain_cash_no_rank_replacement",
    "entry_filter_must_not_remove_signal_day_candidates": true
  },
  "price_and_path": {
    "price_semantics": "corporate_action_adjusted_ohlc",
    "factor": "back_adjust_factor",
    "formula": "adjusted_ohlc = raw_ohlc * back_adjust_factor",
    "volume_amount_adjusted_by_price_factor": false,
    "price_anchor": "today_close",
    "lookback_days": 100,
    "forward_days": 60
  },
  "suspension": {
    "input_ohlc": "carry_last_valid_adjusted_close",
    "input_volume_amount": 0,
    "entry_day_suspension": "unfilled",
    "holding_valuation": "carry_last_valid_adjusted_close",
    "exit_allowed_while_suspended": false,
    "resume_gap_is_observed": true
  },
  "validity_masks": [
    "signal_eligible",
    "entry_filled",
    "price_label_valid",
    "va_aux_valid",
    "observed_price_path",
    "tradable_path",
    "has_bar",
    "is_suspended",
    "previous_close_valid",
    "corr_valid",
    "zero_range"
  ],
  "path_value": {
    "selection_chain": "predicted_path -> deterministic_path_value -> daily_cross_section_rank",
    "default_candidate": "path_value_v2_hard_st",
    "opportunity_value": "oracle diagnostic over the realized path",
    "realized_plan_value": "realized utility at the exit day selected from the predicted path",
    "oracle_regret": "opportunity_value - realized_plan_value"
  },
  "ranking": {
    "screening_candidate": "global_tail_512",
    "path_and_rank_batches_separate": true,
    "date_weighting": "equal",
    "tail_groups": {
      "true_top": 32,
      "true_rank_33_256": 128,
      "middle": 128,
      "bottom": 96,
      "prior_epoch_false_positive": 128
    },
    "conditional_candidate": "sampled_exact_daily_listwise_vjp"
  },
  "evaluation": {
    "inner_oos_years": [2018, 2019, 2020, 2021],
    "historical_outer_oos_years": [2022, 2023, 2024, 2025],
    "historical_outer_evidence_grade": "selection_aware_historical_oos",
    "purge_rule": "label_end_trade_date < oos_start_trade_date",
    "primary_research_metric": "daily Top3 opportunity_value alpha",
    "decision_guardrails": [
      "daily Top3 realized_plan_value alpha",
      "oracle_regret",
      "Top10",
      "daily_rank_ic",
      "worst_fold",
      "fill_rate",
      "path_mae"
    ]
  },
  "protected_boundaries": {
    "overwrite_legacy_artifacts": false,
    "change_active_execution": false,
    "activate_qdp_before_quality_gate": false
  }
}
