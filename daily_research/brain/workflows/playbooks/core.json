      "forbidden_actions": ["edit_brain_docs", "start_training", "modify_active_execution_artifact"],
      "artifacts": ["brain/brain_manifest.json", "daily_research/brain/brain_manifest.json"],
      "writeback_routes": {"state": "daily_research/brain/state_center.md", "operations": "daily_research/brain/operations_center.md", "episodic": "daily_research/brain/episodic_memory.md"},
