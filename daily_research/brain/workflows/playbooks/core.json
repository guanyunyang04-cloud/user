{
  "schema_version": 1,
  "workflows": {
    "continuous_policy_safe_screening": {
      "description": "Run only resource-safe daily_research continuous_policy screening after explicit launch approval from a routed main-brain capsule.",
      "preflight": ["main_brain_capsule", "resource_limits", "no_conflict_process", "unique_run_tag"],
      "checklist": ["confirm_main_brain_routed_to_daily_research", "confirm_resource_profile", "confirm_unique_run_tag", "launch_safe_screening", "monitor_progress", "write_verified_evidence"],
      "allowed_commands": ["run_self_optimizing_study --disable-confirmatory --resource-profile safe --thread-limit 4 --cpu-affinity-count 4"],
      "forbidden_actions": ["enable_true_solver_by_default", "start_confirmatory", "modify_active_execution_artifact", "use_KMP_DUPLICATE_LIB_OK"],
      "artifacts": ["daily_research/output/continuous_policy/studies/<run_tag>/study_progress.json", "daily_research/output/continuous_policy/studies/<run_tag>/study_summary.json"],
      "writeback_routes": {"state": "daily_research/brain/state_center.md", "operations": "daily_research/brain/operations_center.md", "episodic": "daily_research/brain/episodic_memory.md"},
      "completion": ["at_least_one_screening_trial_completed", "resource_gate_explained", "training_evidence_read"],
      "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json"]
    },
    "continuous_policy_result_review": {
      "description": "Read study/protocol/audit/ledger artifacts and decide whether daily_research evidence supports continuation.",
      "preflight": ["main_brain_capsule", "artifact_freshness", "study_summary_readable", "protocol_summary_readable_if_available"],
      "checklist": ["check_freshness", "read_explicit_run_tag_if_needed", "separate_smoke_from_completed_evidence", "list_gaps", "choose_next_allowed_action"],
      "allowed_commands": [
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.workflow status --workflow continuous_policy --json",
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.workflow status --workflow continuous_policy --run-tag <tag> --json",
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.workflow writeback-plan --source latest --json",
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.workflow writeback-plan --source run:<tag> --json"
      ],
      "forbidden_actions": ["promote_from_screening_only", "modify_active_execution_artifact", "treat_loose_latest_as_truth_without_freshness"],
      "artifacts": ["daily_research/output/continuous_policy/latest_study_summary.json", "daily_research/output/continuous_policy/latest_protocol_summary.json", "daily_research/output/continuous_policy/latest_behavior_audit_summary.json", "daily_research/output/continuous_policy/latest_conclusion_ledger.json"],
      "writeback_routes": {"state": "daily_research/brain/state_center.md", "knowledge": "daily_research/brain/knowledge_center.md", "operations": "daily_research/brain/operations_center.md", "episodic": "daily_research/brain/episodic_memory.md"},
      "completion": ["freshness_report_written", "explicit_run_evidence_capsule_read_if_latest_is_stale", "evidence_gap_listed", "next_allowed_action_selected"],
      "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json"]
    }
  }
}
