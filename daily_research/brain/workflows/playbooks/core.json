      "completion": ["doc_guard_ok", "brain_integrity_ok", "operations_center_under_line_limit"],
      "validation_commands": ["C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/doc_guard.py check", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/brain_integrity_check.py --json"]
