  "brainstorming_design": {
    "description": "Turn a new feature, route, architecture change, or experiment idea into a clear design before implementation.",
    "preflight": ["task_capsule", "project_context_read", "scope_boundary_identified"],
    "checklist": ["state_goal_success_criteria", "separate_facts_inferences_assumptions_boundaries", "compare_approaches", "select_recommended_design", "define_acceptance_criteria"],
    "allowed_commands": ["daily_research/tools/brain_workflow.py capsule --child daily_research --task <task> --workflow auto --json", "daily_research/tools/brain_workflow.py query --q <term> --json"],
    "forbidden_actions": ["write_implementation_code_before_design", "start_long_training", "modify_active_execution_artifact"],
    "stop_conditions": ["goal_or_success_criteria_unclear", "scope_too_large_for_one_design", "required_context_missing"],
    "writeback_routes": {"references": "daily_research/brain/references/", "operations": "daily_research/brain/operations_center.md"},
    "completion": ["design_is_decision_complete", "scope_boundaries_explicit", "acceptance_criteria_written"],
    "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json"]
  },
  "writing_plan": {
    "description": "Convert an approved design or stable intent into an implementation-ready plan without executing it.",
    "preflight": ["task_capsule", "design_or_user_intent_read", "repo_context_checked"],
    "checklist": ["define_implementation_steps", "define_interfaces_and_data_flow", "define_edge_cases_and_failure_modes", "define_tests_and_guards", "record_assumptions_and_defaults"],
    "allowed_commands": ["daily_research/tools/brain_workflow.py capsule --child daily_research --task <task> --workflow auto --json", "daily_research/tools/brain_workflow.py workflow-guide --workflow writing_plan --json"],
    "forbidden_actions": ["edit_tracked_files_to_execute_plan", "start_training", "modify_active_execution_artifact"],
    "stop_conditions": ["implementation_decision_missing", "test_or_guard_plan_missing", "scope_boundary_ambiguous"],
    "writeback_routes": {"references": "daily_research/brain/references/"},
    "completion": ["plan_is_decision_complete", "tests_and_guards_explicit", "assumptions_recorded"],
    "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json"]
  },
  "executing_plan": {
    "description": "Execute an explicit user-approved plan step by step with verification and writeback.",
    "preflight": ["task_capsule", "plan_read", "active_artifact_guard_clean"],
    "checklist": ["review_plan_for_conflicts", "execute_steps_in_order", "stop_and_debug_on_failure", "run_required_guards", "writeback_verified_evidence"],
    "allowed_commands": ["daily_research/tools/brain_workflow.py capsule --child daily_research --task <task> --workflow auto --json", "daily_research/tools/brain_workflow.py workflow-guide --workflow executing_plan --json"],
    "forbidden_actions": ["skip_plan_steps", "skip_verification", "treat_failed_or_interrupted_work_as_complete", "modify_active_execution_artifact"],
    "stop_conditions": ["plan_conflict_or_gap_found", "verification_fails_repeatedly", "required_dependency_missing"],
    "writeback_routes": {"references": "daily_research/brain/references/", "state": "daily_research/brain/state_center.md", "operations": "daily_research/brain/operations_center.md"},
    "completion": ["all_plan_items_accounted_for", "fresh_guards_passed", "writeback_done_if_evidence_changed"],
    "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json", "git diff --check", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/doc_guard.py check", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/brain_integrity_check.py --json"]
  },
  "systematic_debugging": {
    "description": "Diagnose bugs, failed tests, interrupted training, CUDA/OOM issues, or abnormal metrics before proposing fixes.",
    "preflight": ["task_capsule", "symptom_and_artifact_identified", "active_artifact_guard_clean"],
    "checklist": ["reproduce_or_read_failure_artifact", "identify_smallest_likely_cause", "make_minimal_fix", "add_or_run_regression_test", "verify_original_symptom_is_gone"],
    "allowed_commands": ["daily_research/tools/brain_workflow.py capsule --child daily_research --task <task> --workflow auto --json", "daily_research/tools/brain_workflow.py query --q <error_or_tag> --json"],
    "forbidden_actions": ["guess_fix_without_evidence", "large_unrelated_refactor", "modify_active_execution_artifact"],
    "stop_conditions": ["cannot_reproduce_or_locate_failure", "fix_requires_policy_or_scope_decision", "resource_risk_exceeds_current_boundary"],
    "writeback_routes": {"references": "daily_research/brain/references/", "operations": "daily_research/brain/operations_center.md"},
    "completion": ["root_cause_or_best_evidence_stated", "regression_guard_run", "residual_risk_recorded"],
    "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json", "git diff --check"]
  },
  "verification_before_completion": {
    "description": "Run fresh verification before claiming work is complete, fixed, passing, or safe.",
    "preflight": ["task_capsule", "claim_to_verify_identified"],
    "checklist": ["identify_command_that_proves_claim", "run_fresh_verification", "read_exit_code_and_output", "state_result_and_residual_risk", "avoid_completion_claim_if_verification_failed"],
    "allowed_commands": ["daily_research/tools/doc_guard.py check", "daily_research/tools/brain_integrity_check.py --json", "git diff --check", "git diff -- daily_research/output/active_execution_strategy.json"],
    "forbidden_actions": ["claim_complete_without_fresh_verification", "ignore_failed_guard", "modify_active_execution_artifact"],
    "stop_conditions": ["verification_command_missing", "verification_fails", "output_not_read_or_ambiguous"],
    "writeback_routes": {"references": "daily_research/brain/references/"},
    "completion": ["fresh_verification_passed", "claim_matches_evidence", "active_artifact_diff_checked"],
    "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json", "git diff --check", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/doc_guard.py check", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe daily_research/tools/brain_integrity_check.py --json"]
