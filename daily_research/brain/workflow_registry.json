{
  "brain_handoff": {
    "description": "Resolve the main-brain and child-brain handoff capsule before entering project body work.",
    "preflight": [
      "brain_integrity",
      "doc_guard"
    ],
    "allowed_commands": [
      "daily_research/tools/brain_workflow.py handoff --child <brain_id> --json",
      "daily_research/tools/brain_bootstrap.py --child <brain_id> --json"
    ],
    "forbidden_actions": [
      "edit_brain_docs",
      "start_training",
      "modify_active_execution_artifact"
    ],
    "artifacts": [
      "brain/brain_manifest.json",
      "daily_research/brain/brain_manifest.json"
    ],
    "writeback_routes": {
      "state": "daily_research/brain/state_center.md",
      "operations": "daily_research/brain/operations_center.md",
      "episodic": "daily_research/brain/episodic_memory.md"
    },
    "completion": [
      "boot_order_resolved",
      "fast_handoff_paths_resolved",
      "encoding_report_clean"
    ]
  },
