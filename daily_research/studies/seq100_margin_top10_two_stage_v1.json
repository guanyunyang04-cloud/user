        "legal_gross_return": {
            "kind": "regression",
            "definition": "adjusted close[t+2] / adjusted open[t+1] - 1",
            "training_winsorization": "same-date 1st/99th percentile while preserving return units",
            "outcome_dependency_trading_days": 2
