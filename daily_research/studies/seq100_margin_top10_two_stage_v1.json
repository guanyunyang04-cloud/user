    },
    "second_stage": {
        "outer_folds": "identical to base-model folds",
        "daily_selections": [1, 3],
        "variants": {
            "margin_rank": "original absolute financing-increment rank",
            "m0_transparent_66": "transparent full-market base predictions",
            "m1_compact_557": "557-field full-market base predictions",
            "m2_direct_557_margin": "direct candidate LightGBM using 557 fields plus financing features; overfit-risk control",
