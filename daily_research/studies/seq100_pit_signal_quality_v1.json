    "workflow": {
      "cli_module": "daily_research.path_policy.seq100_signal_quality",
      "output_root": "daily_research/output/path_policy/studies/seq100_pit_signal_quality_v1",
      "commands": [
        "validate-research",
        "build-targets",
        "freeze-target",
        "build-view",
        "screen-models",
        "train",
        "evaluate",
        "closeout"
      ],
      "stages": {
        "validate-research": {
          "reads": [
            "contracts",
            "source manifests",
            "external research evidence"
          ],
          "writes": [
            "validation attempt"
          ],
          "max_result_year": null
        },
        "build-targets": {
          "reads": [
            "frozen source pack D1-D60 through 2025"
          ],
          "writes": [
            "derived target view under ignored output"
          ],
          "max_result_year": 2025
        },
        "freeze-target": {
          "reads": [
            "target view 2010-2021 only"
          ],
          "writes": [
            "target comparison and frozen target pointer"
          ],
          "max_result_year": 2021
        },
        "build-view": {
          "reads": [
            "signal-date and earlier PIT domains through 2025"
          ],
          "writes": [
            "derived features/fold views under ignored output"
          ],
          "max_result_year": 2025
        },
        "screen-models": {
          "reads": [
            "2010-2022 only"
          ],
          "writes": [
            "resource preflight, feature screen, formal matrix"
          ],
          "max_result_year": 2022
        },
        "train": {
          "reads": [
            "one registered formal fold per invocation"
          ],
          "writes": [
            "checkpoint, log, compact full-candidate predictions"
          ],
          "max_result_year": 2025
        },
        "evaluate": {
          "reads": [
            "complete 2023-2025 predictions only"
          ],
          "writes": [
            "bootstrap metrics and winner decision"
          ],
          "max_result_year": 2025
        },
        "closeout": {
          "reads": [
            "completed evidence"
          ],
          "writes": [
            "indexed compact research record, state pointers, active-contract removal"
          ],
          "max_result_year": 2025
        }
      }
    },
