  "project_profile": {
    "guard_profile": {
      "active_artifact_guard": false,
      "artifact_freshness": false,
      "frontier_report": false,
      "project_consistency": false,
      "openmp_strict": false,
      "brain_rules": true
    },
    "verification_profile": {
      "always_commands": [
        "git diff --check",
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.doc_guard check --scope changed",
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.integrity_check --json"
      ],
      "default_test_commands": [
        "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m pytest quant_data_platform/tests -q"
      ],
      "big_artifact_paths": [
        "quant_data_platform/data/**"
      ]
    },
    "commit_policy": {
      "auto_commit": true,
      "message_prefix": "quant_data_platform",
      "allowed_prefixes": [
        "quant_data_platform/"
      ],
      "block_on_baseline_overlap": true
    },
    "process_namespace": {
      "root": "quant_data_platform/data/agent_runs",
      "run_path_template": "quant_data_platform/data/agent_runs/<run_id>",
      "pid_registry": "quant_data_platform/data/agent_runs/<run_id>/pid.json",
      "stdout": "quant_data_platform/data/agent_runs/<run_id>/stdout.log",
      "stderr": "quant_data_platform/data/agent_runs/<run_id>/stderr.log",
      "progress": "quant_data_platform/data/agent_runs/<run_id>/progress.json",
      "summary": "quant_data_platform/data/agent_runs/<run_id>/summary.json"
    },
    "cross_project_policy": {
      "allow_by_default": false,
      "lease_root": "brain/output/resource_leases"
    }
  },
  "handoff_contract": {
    "derive_entry_sequence_from_shared_contract": true,
    "body_entry_priority": [
      "core",
      "configs",
      "registry",
      "data_assets",
      "knowledge_docs",
      "tests"
    ],
    "principle": "先接入分脑，再确认 canonical 数据契约、registry、数据资产边界和验证入口，最后进入对应 body_map。"
  },
  "parent_brain": "brain/brain_manifest.json",
  "shared_contract_source": "brain/brain_manifest.json#shared_regional_brain_contract"
