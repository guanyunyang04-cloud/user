      "artifacts": ["progress_json", "stdout_log", "stderr_log", "artifact_dir"],
      "stop_conditions": ["pid_missing", "progress_and_logs_missing", "stalled_without_artifact_or_log_progress", "resource_risk_exceeds_current_boundary"],
