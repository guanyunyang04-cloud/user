    "long_task": {
      "description": "Launch or monitor long-running training, research, build, or data jobs with PID-bound wait windows and ETA reporting.",
      "preflight": ["task_capsule_with_long_task_intent", "active_artifact_guard_clean", "progress_or_log_path_identified"],
      "checklist": ["start_process_with_pid", "wait_with_pid_bound_window", "report_elapsed_and_eta_each_poll", "inspect_logs_and_artifact_mtime", "continue_only_if_pid_or_artifacts_progress"],
      "allowed_commands": ["Wait-Process -Id <pid> -Timeout 7200", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.long_task_monitor template --json", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.long_task_monitor status --pid <pid> --progress <progress.json> --stdout <stdout.log> --stderr <stderr.log> --artifact-dir <artifact_dir> --json", "C:/Users/ASUS/miniconda3/envs/yolos/python.exe -m tools.brain.long_task_monitor wait-once --pid <pid> --timeout 7200 --progress <progress.json> --stdout <stdout.log> --stderr <stderr.log> --artifact-dir <artifact_dir> --json"],
