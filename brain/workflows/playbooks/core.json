      "validation_commands": ["git diff -- daily_research/output/active_execution_strategy.json", "git diff --check"],
      "long_task_contract": {
        "required_wait_command": "Wait-Process -Id <pid> -Timeout 7200",
        "poll_window_seconds": 7200,
        "forbidden_patterns": ["Start-Sleep", "fixed sleep polling", "timeout as business failure"],
        "status_required_fields": ["pid_alive", "elapsed_seconds", "estimated_remaining_seconds", "eta_at", "progress_percent", "latest_metric", "last_log_lines", "artifact_mtime", "decision"],
        "eta_required": true,
        "continue_conditions": ["pid_alive", "progress_updated", "log_updated", "artifact_mtime_updated"],
        "stop_conditions": ["process_exited_and_artifacts_verified", "process_exited_with_error", "stalled_or_waiting_requires_inspection", "resource_risk_exceeds_current_boundary"]
