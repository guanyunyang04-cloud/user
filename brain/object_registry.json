{
  "schema": "workspace-brain/objects/v1",
  "objects": [
    {
      "object_id": "qdp_datasets",
      "owner": "quant_data_platform",
      "type": "protected_data",
      "paths": [
        "quant_data_platform/data/qdp_v2",
        "quant_data_platform/data/event_packs"
      ],
      "truth": "active.json + dataset.json + referenced parquet",
      "mutation": "only explicit QDP data work with post-change status/check"
    },
    {
      "object_id": "research_datasets",
      "owner": "daily_research",
      "type": "protected_data",
      "paths": ["daily_research/data/research_store"],
      "truth": "pack/overlay manifests and their referenced material",
      "mutation": "only explicit dataset work; duplicates require byte/semantic proof"
    },
    {
      "object_id": "seq100_models",
      "owner": "daily_research",
      "type": "protected_model",
      "paths": [
        "daily_research/models/registry.json",
        "daily_research/models/seq100"
      ],
      "truth": "registry path and SHA-256",
      "mutation": "register or replace a bundle atomically, then verify all hashes"
    },
    {
      "object_id": "research_records",
      "owner": "daily_research",
      "type": "compact_evidence",
      "paths": ["daily_research/research_records"],
      "truth": "indexed final report, key metrics, and contract",
      "mutation": "append or replace one indexed conclusion; no process logs"
    },
    {
      "object_id": "active_studies",
      "owner": "daily_research",
      "type": "active_research",
      "paths": ["daily_research/studies"],
      "truth": "one contract per unfinished study",
      "mutation": "finish, compact evidence, and remove experiment-only machinery"
    },
    {
      "object_id": "brain_system",
      "owner": "workspace",
      "type": "takeover_map",
      "paths": ["brain", "daily_research/brain", "quant_data_platform/brain"],
      "truth": "manifest + README + state",
      "mutation": "keep current facts only and run integrity_check"
    }
  ]
}
